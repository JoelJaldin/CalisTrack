@model Alumno
@{ ViewData["Title"] = "Perfil del alumno"; var asignaciones = (List<AsignacionRutina>)ViewBag.Asignaciones; var sesiones = (List<Entrenamiento>)ViewBag.Recientes; var semanas = (List<SemanaProgreso>)ViewBag.Semanas; }
<div class="page-heading"><div><h1>@Model.Nombre</h1><p>Mis alumnos › Perfil del alumno</p></div></div>
<div class="student-detail-layout"><div><section class="panel"><div class="profile-intro"><span class="avatar large">@Presentacion.Iniciales(Model.Nombre)</span><div><h2>@Model.Nombre</h2><small class="muted">@Model.Email</small></div></div><p class="student-objective">Objetivo: @(string.IsNullOrWhiteSpace(Model.Objetivo) ? "Todavía no definido" : Model.Objetivo)</p><span class="badge success">Vínculo activo</span><div class="actions"><a class="button secondary small-button" asp-controller="Chat" asp-action="Index" asp-route-contactoId="@Model.Id"><svg><use href="/img/icons.svg#chat" /></svg>Abrir chat</a></div></section>
<section class="panel"><span class="eyebrow">RUTINAS ASIGNADAS</span>
@if(asignaciones.Count == 0){<p class="muted">Todavía no tiene una rutina asignada.</p>}
@foreach(var asignacion in asignaciones){<div class="assigned-routine"><h2>@asignacion.Rutina.Nombre</h2><p class="help">Del @asignacion.FechaDesde.ToString("dd/MM/yyyy") @(asignacion.FechaHasta.HasValue ? "al " + asignacion.FechaHasta.Value.ToString("dd/MM/yyyy") : "en adelante")</p><form asp-controller="Rutinas" asp-action="FinalizarAsignacion" method="post" data-confirm="¿Finalizar esta asignación? El historial se conserva."><input type="hidden" name="id" value="@asignacion.Id" /><button class="text-button danger" type="submit">Finalizar asignación</button></form></div>}
<div class="actions"><a class="button secondary small-button" asp-controller="Rutinas" asp-action="Index">Asignar otra rutina</a></div></section></div>
<div><section class="panel"><div class="section-heading"><h2>Progreso semanal</h2><span class="badge subtle">@ViewBag.Sesiones sesiones</span></div><partial name="_Progreso" model="semanas" /></section><section class="panel"><div class="section-heading"><h2>Historial y devoluciones</h2><a class="text-link" asp-controller="Historial" asp-action="Index" asp-route-alumnoId="@Model.Id">Ver todo</a></div>
@if(sesiones.Count == 0){<p class="empty compact">Todavía no hay entrenamientos finalizados.</p>}
@foreach(var sesion in sesiones){<div class="list-row"><small>@sesion.Fecha.ToString("dd/MM/yyyy")</small><span class="grow"><strong>@sesion.NombreRutina</strong><small>@sesion.Registros.Where(r => r.Completada).Sum(r => r.Repeticiones) repeticiones</small></span><span class="badge @(sesion.Devoluciones.Count > 0 ? "success" : "pending")">@(sesion.Devoluciones.Count > 0 ? "Con devolución" : "Sin devolución")</span><a class="@(sesion.Devoluciones.Count > 0 ? "text-link" : "button primary small-button")" asp-controller="Entrenamientos" asp-action="Detalle" asp-route-id="@sesion.Id">@(sesion.Devoluciones.Count > 0 ? "Ver" : "Dar devolución")</a></div>}
</section></div></div>
