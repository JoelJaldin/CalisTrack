@model EjercicioViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo ejercicio" : "Editar ejercicio"; }
<a class="back-link" asp-action="Index">← Biblioteca</a><div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Explicá el movimiento y agregá material para acompañar la técnica.</p></div></div>
<form method="post" enctype="multipart/form-data" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="exercise-editor-layout"><section class="panel form-stack"><div class="field"><label asp-for="Nombre">Nombre del ejercicio</label><input asp-for="Nombre" maxlength="100" required placeholder="Ej. Dominadas" /><span asp-validation-for="Nombre"></span></div>
<div class="field"><label asp-for="GrupoMuscular">Grupo muscular</label><select asp-for="GrupoMuscular"><option>General</option><option>Espalda</option><option>Pecho</option><option>Tríceps</option><option>Hombros</option><option>Piernas</option><option>Core</option></select><span asp-validation-for="GrupoMuscular"></span></div>
<div class="field"><label asp-for="Descripcion">Descripción y técnica</label><textarea asp-for="Descripcion" rows="5" maxlength="2000" placeholder="Cómo se realiza, qué cuidar y cómo adaptar el ejercicio..."></textarea><span asp-validation-for="Descripcion"></span></div>
</section><section class="panel form-stack"><h2>Material multimedia</h2><div class="field"><label asp-for="Enlace">Enlace a una demostración <span class="muted">(opcional)</span></label><input asp-for="Enlace" type="url" placeholder="https://..." /><span asp-validation-for="Enlace"></span></div>
<div class="field"><label asp-for="Archivo">Foto, video o PDF <span class="muted">(opcional)</span></label><input asp-for="Archivo" type="file" accept=".jpg,.jpeg,.png,.webp,.mp4,.webm,.pdf" /><small>JPG, PNG, WebP, MP4, WebM o PDF. Máximo 20 MB.</small><span asp-validation-for="Archivo"></span></div>
</section></div><div class="form-actions start"><a class="button secondary" asp-action="Index">Cancelar</a><button type="submit" class="button primary">Guardar ejercicio</button></div></form>
@if(Model.Materiales.Count > 0){<section class="panel"><h2>Material disponible</h2>@foreach(var m in Model.Materiales){<div class="list-row"><span class="grow"><strong>@m.Descripcion</strong><small>@m.Tipo</small></span>@if(m.ArchivoAdjuntoId.HasValue){<a class="text-link" asp-controller="Archivos" asp-action="Ver" asp-route-id="@m.ArchivoAdjuntoId" target="_blank" rel="noopener">Ver archivo</a>}else{<a class="text-link" href="@m.ArchivoUrl" target="_blank" rel="noopener noreferrer">Abrir enlace</a>}<form asp-action="EliminarMaterial" method="post" data-confirm="¿Quitar este material del ejercicio?"><input type="hidden" name="id" value="@m.Id" /><button class="text-button danger" type="submit">Quitar</button></form></div>}</section>}
