@model List<Ejercicio>
@{ ViewData["Title"] = "Biblioteca de ejercicios"; }
<div class="page-heading"><div><h1>Biblioteca de ejercicios</h1><p>Ejercicios con explicación técnica, fotos y videos</p></div><a class="button primary" asp-action="Editar"><svg><use href="/img/icons.svg#plus" /></svg>Nuevo ejercicio</a></div>
<form class="searchbar" method="get"><svg><use href="/img/icons.svg#search" /></svg><input name="buscar" value="@ViewBag.Buscar" placeholder="Buscar ejercicio o grupo muscular" aria-label="Buscar ejercicios" /><button class="button secondary">Buscar</button></form>
@if(Model.Count == 0){<section class="panel empty"><svg><use href="/img/icons.svg#book" /></svg><h2>Tu biblioteca está lista para crecer</h2><p>Creá tu primer ejercicio o probá otra búsqueda.</p><a class="button primary" asp-action="Editar">Crear ejercicio</a></section>}
<div class="cards-grid">@foreach(var e in Model){<article class="panel exercise-card"><div class="exercise-art"><svg><use href="@(e.Materiales.Count > 0 ? "/img/icons.svg#play" : "/img/icons.svg#book")" /></svg><span class="badge">@e.GrupoMuscular</span></div><div class="exercise-content"><h2>@e.Nombre</h2><p class="clamp">@e.Descripcion</p><small class="muted">@e.Materiales.Count material(es) de técnica</small><div class="card-bottom"><a class="text-link" asp-action="Editar" asp-route-id="@e.Id">Ver y editar →</a><form asp-action="Eliminar" method="post" data-confirm="¿Dar de baja este ejercicio?"><input type="hidden" name="id" value="@e.Id" /><button class="text-button danger" type="submit">Dar de baja</button></form></div></div></article>}</div>
