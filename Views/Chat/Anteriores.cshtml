@model List<Mensaje>
@{ ViewData["Title"] = "Mensajes anteriores"; var id = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!); }
<a class="back-link" asp-action="Index" asp-route-contactoId="@ViewBag.ContactoId">← Volver a la conversación</a><section class="panel narrow"><h1>Mensajes anteriores</h1>@if(Model.Count == 0){<p>No hay más mensajes.</p>}@if(Model.Count == 200){<a class="text-link" asp-action="Anteriores" asp-route-contactoId="@ViewBag.ContactoId" asp-route-antesDe="@Model.First().Id">Cargar mensajes más antiguos</a>}<div class="messages">@foreach(var m in Model){<article class="message @(m.EmisorId == id ? "mine" : "theirs")"><p class="preserve-lines">@m.Texto</p>@if(m.ArchivoAdjuntoId.HasValue){<a asp-controller="Archivos" asp-action="Ver" asp-route-id="@m.ArchivoAdjuntoId" asp-route-descargar="true">@m.ArchivoAdjunto?.Nombre</a>}<small>@Fecha.Local(m.FechaHora).ToString("dd/MM/yyyy HH:mm")</small></article>}</div></section>
