@model ChatViewModel
@{ ViewData["Title"] = "Chat"; }
<div class="page-heading"><div><h1>Chat</h1><p>@(User.IsInRole(Roles.Alumno) ? "Conversación con tu entrenador" : "Mensajes con tus alumnos vinculados")</p></div><a class="button secondary small-button" asp-action="Index" asp-route-contactoId="@Model.Contacto?.Id">Actualizar mensajes</a></div>
<div class="chat-layout"><aside class="chat-contacts panel"><h2>Conversaciones</h2>@if(Model.Contactos.Count == 0){<p class="muted">Cuando tengas un vínculo activo, vas a poder conversar acá.</p>}@foreach(var c in Model.Contactos){<a class="contact @(Model.Contacto?.Id == c.Id ? "selected" : "")" asp-action="Index" asp-route-contactoId="@c.Id"><span class="avatar">@Presentacion.Iniciales(c.Nombre)</span><span><strong>@c.Nombre</strong><small>@c.Rol</small></span></a>}</aside>
<section class="chat-window panel">@if(Model.Contacto == null){<div class="empty"><svg><use href="/img/icons.svg#chat" /></svg><h2>Tu espacio para conversar</h2><p>Seleccioná una conversación para empezar.</p></div>}
else{<header class="chat-header"><span class="avatar">@Presentacion.Iniciales(Model.Contacto.Nombre)</span><div><h2>@Model.Contacto.Nombre</h2><small>@Model.Contacto.Rol</small></div><span class="badge success">Vínculo activo</span></header><div class="messages" id="messages">@if(Model.Mensajes.Count == 200){<a class="text-link" asp-action="Anteriores" asp-route-contactoId="@Model.Contacto.Id" asp-route-antesDe="@Model.Mensajes.First().Id">Ver mensajes anteriores</a>}@if(Model.Mensajes.Count == 0){<p class="empty compact">Todavía no hay mensajes. ¡Iniciá la conversación!</p>}@foreach(var m in Model.Mensajes){<article class="message @(m.EmisorId == Model.UsuarioId ? "mine" : "theirs")">@if(!string.IsNullOrEmpty(m.Texto)){<p class="preserve-lines">@m.Texto</p>}@if(m.ArchivoAdjuntoId.HasValue){<a class="attachment" asp-controller="Archivos" asp-action="Ver" asp-route-id="@m.ArchivoAdjuntoId" asp-route-descargar="true"><svg><use href="/img/icons.svg#attachment" /></svg>@m.ArchivoAdjunto?.Nombre</a>}<small>@Fecha.Local(m.FechaHora).ToString("dd/MM HH:mm") @(m.EmisorId == Model.UsuarioId ? (m.Leido ? "· Leído ✓✓" : "· Enviado ✓") : "")</small></article>}</div><form asp-action="Enviar" method="post" enctype="multipart/form-data" class="chat-composer"><input name="contactoId" type="hidden" value="@Model.Contacto.Id" /><label class="sr-only" for="mensaje">Mensaje</label><textarea id="mensaje" name="texto" maxlength="2000" rows="2" placeholder="Escribí un mensaje..."></textarea><div class="composer-actions"><div class="field"><label for="adjunto">Adjuntar archivo <small>(hasta 20 MB)</small></label><input id="adjunto" name="archivo" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf,.mp4,.webm" /></div><button class="button primary" type="submit">Enviar <svg><use href="/img/icons.svg#send" /></svg></button></div></form>}
</section></div>
