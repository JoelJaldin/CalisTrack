@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="auth-card login-card">
    <div class="auth-heading"><h1>Hola de nuevo</h1><p>Ingresá con tu email y contraseña.</p></div>
    <form method="post" class="form-stack">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" placeholder="tu@email.com" required /><span asp-validation-for="Email"></span></div>
        <div class="field"><label asp-for="Password">Contraseña</label><div class="password-field"><input asp-for="Password" autocomplete="current-password" placeholder="Ingresá tu contraseña" required /><button type="button" class="show-password" data-password="Password" aria-label="Mostrar contraseña">Ver</button></div><span asp-validation-for="Password"></span></div>
        <button class="button primary full" type="submit">Ingresar</button>
    </form>
    <div class="login-register">
        <span>¿Todavía no tenés cuenta?</span>
        <a asp-action="Registro" class="text-link">Crear cuenta <svg aria-hidden="true"><use href="/img/icons.svg#arrow" /></svg></a>
    </div>
</div>
