@model PerfilViewModel
@{ ViewData["Title"] = "Mi perfil"; var rol = User.FindFirstValue(ClaimTypes.Role); }
<div class="page-heading"><div><h1>Mi perfil</h1><p>Datos personales</p></div></div>
<div class="profile-layout"><aside class="panel"><div class="profile-intro"><span class="avatar large @(rol == Roles.Entrenador ? "coach" : "")">@Presentacion.Iniciales(User.Identity?.Name)</span><div><h2>@User.Identity?.Name</h2><span class="role-badge" data-role="@rol">@(rol == Roles.SuperAdmin ? "Super Admin" : rol)</span></div></div><p class="help profile-status">Cuenta activa</p></aside>
<form method="post" class="panel form-stack"><div asp-validation-summary="ModelOnly" class="validation"></div><h2>Datos personales</h2><div class="form-grid"><div class="field"><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" required maxlength="100" /><span asp-validation-for="Nombre"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" required maxlength="200" /><span asp-validation-for="Email"></span></div></div>
@if(User.IsInRole(Roles.Alumno)){<div class="field"><label asp-for="Objetivo">Objetivo</label><textarea asp-for="Objetivo" maxlength="500" rows="2"></textarea><span asp-validation-for="Objetivo"></span></div>}
<div class="form-grid"><div class="field"><label asp-for="PasswordActual">Contraseña actual</label><input asp-for="PasswordActual" autocomplete="current-password" /><span asp-validation-for="PasswordActual"></span><small>Necesaria para cambiar tu email o contraseña.</small></div><div class="field"><label>Rol</label><div class="readonly-field">@(rol == Roles.SuperAdmin ? "Super Admin" : rol)</div><small>El rol solo lo cambia el Super Admin.</small></div></div><div class="field"><label asp-for="PasswordNueva">Nueva contraseña (opcional)</label><input asp-for="PasswordNueva" autocomplete="new-password" minlength="8" maxlength="100" /><span asp-validation-for="PasswordNueva"></span><small>Mínimo 8 caracteres.</small></div><div class="form-actions start"><button class="button primary" type="submit">Guardar cambios</button><button class="button secondary danger" type="submit" form="salir-perfil">Cerrar sesión</button></div></form></div>
<form id="salir-perfil" asp-action="Salir" method="post"></form>
