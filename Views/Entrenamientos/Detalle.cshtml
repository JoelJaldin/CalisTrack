@model Entrenamiento
@{ ViewData["Title"] = "Devolución del entrenamiento"; var entrenador = User.IsInRole(Roles.Entrenador); var userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!); }
<div class="page-heading"><div><h1>@(entrenador ? "Devolución del entrenamiento" : "Devolución de tu entrenador")</h1><p>Historial › Entrenamiento del @Model.Fecha.ToString("dd/MM/yyyy")</p></div></div>
<div class="feedback-layout"><section class="panel"><span class="eyebrow">ENTRENAMIENTO @(Model.Finalizado ? "FINALIZADO" : "EN CURSO")</span><h2>@Model.NombreRutina</h2><p class="muted">@Model.Fecha.ToString("dd/MM/yyyy") · @Model.AsignacionRutina.Alumno.Nombre</p>
@foreach(var grupo in Model.Registros.OrderBy(r => r.RutinaEjercicio.Orden).ThenBy(r => r.NumeroSerie).GroupBy(r => r.RutinaEjercicioId))
{
    <div class="exercise-summary"><strong>@grupo.First().NombreEjercicio</strong><span>@string.Join(" · ", grupo.Select(r => r.Completada ? r.Repeticiones.ToString() : "—"))</span></div>
}
<p class="help">@Model.Registros.Count(r => r.Completada) series realizadas · @Model.Registros.Where(r => r.Completada).Sum(r => r.Repeticiones) repeticiones</p>
@if(!string.IsNullOrWhiteSpace(Model.Comentario)){<div class="note"><strong>Comentario del alumno</strong><p class="preserve-lines">@Model.Comentario</p></div>}
<details><summary>Ver registro completo</summary><div class="table-wrap"><table><thead><tr><th>Ejercicio</th><th>Serie</th><th>Objetivo</th><th>Reps</th><th>Segundos</th><th>Estado</th></tr></thead><tbody>@foreach(var registro in Model.Registros.OrderBy(r => r.RutinaEjercicio.Orden).ThenBy(r => r.NumeroSerie)){<tr><td>@registro.NombreEjercicio</td><td>@registro.NumeroSerie</td><td>@registro.RepeticionesObjetivo reps</td><td>@registro.Repeticiones</td><td>@(registro.TiempoSegundos?.ToString() ?? "—")</td><td>@(registro.Completada ? "Realizada" : "Sin realizar")</td></tr>}</tbody></table></div></details><a class="button secondary small-button" asp-controller="Historial" asp-action="Index" asp-route-alumnoId="@Model.AsignacionRutina.AlumnoId">← Volver al historial</a></section>
<section class="panel"><h2>@(entrenador ? "Tu devolución" : "Devolución de tu entrenador")</h2>
@if(Model.Devoluciones.Count == 0){<p class="empty compact">Todavía no hay devoluciones para esta sesión.</p>}
@foreach(var d in Model.Devoluciones.OrderBy(d => d.FechaHora)){<article class="feedback"><div class="feedback-header"><span class="avatar">@Presentacion.Iniciales(d.Entrenador.Nombre)</span><div><strong>@d.Entrenador.Nombre</strong><small>@Fecha.Local(d.FechaHora).ToString("dd/MM/yyyy HH:mm")</small></div></div><p class="preserve-lines">@d.Texto</p>@if(d.ArchivoAdjuntoId.HasValue){<a class="attachment" asp-controller="Archivos" asp-action="Ver" asp-route-id="@d.ArchivoAdjuntoId" asp-route-descargar="true"><svg><use href="/img/icons.svg#attachment" /></svg>@d.ArchivoAdjunto?.Nombre</a>}
@if(entrenador && d.EntrenadorId == userId){<details><summary>Editar devolución</summary><form asp-action="Devolver" method="post" enctype="multipart/form-data" class="form-stack"><input name="entrenamientoId" value="@Model.Id" type="hidden" /><input name="devolucionId" value="@d.Id" type="hidden" /><div class="field"><label for="feedback-@d.Id">Devolución</label><textarea id="feedback-@d.Id" name="texto" required maxlength="2000" rows="3">@d.Texto</textarea></div><div class="field"><label for="file-@d.Id">Reemplazar adjunto (opcional)</label><input id="file-@d.Id" name="archivo" type="file" accept=".jpg,.jpeg,.png,.webp,.mp4,.webm,.pdf" /></div><button class="button primary" type="submit">Guardar devolución</button></form></details>}
</article>}
@if(entrenador && Model.Finalizado){<form asp-action="Devolver" method="post" enctype="multipart/form-data" class="form-stack"><input name="entrenamientoId" value="@Model.Id" type="hidden" /><div class="field"><label for="texto">Nueva devolución</label><textarea name="texto" id="texto" rows="4" required maxlength="2000" placeholder="Compartí tu devolución sobre esta sesión..."></textarea></div><div class="field"><label for="archivo">Adjuntar material (opcional)</label><input type="file" id="archivo" name="archivo" accept=".jpg,.jpeg,.png,.webp,.mp4,.webm,.pdf" /><small>Hasta 20 MB.</small></div><div class="form-actions"><button type="submit" class="button primary">Enviar devolución</button></div></form>}
</section>

</div>
