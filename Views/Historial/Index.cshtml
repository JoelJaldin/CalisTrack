@model HistorialViewModel
@{ ViewData["Title"] = "Historial y progreso"; var max = Math.Max(1, Model.Semanas.Select(s => s.Repeticiones).DefaultIfEmpty().Max()); }
<div class="page-heading"><div><h1>Historial y progreso</h1><p>@Model.NombreAlumno · Cada entrenamiento deja su marca.</p></div>@if(User.IsInRole(Roles.Alumno)){<a class="button primary" asp-controller="Rutinas" asp-action="MiRutina">Ir a mi rutina</a>}else{<a class="button secondary" asp-controller="Alumnos" asp-action="Detalle" asp-route-id="@Model.AlumnoId">Perfil del alumno</a>}</div>
<form method="get" class="panel filter-form"><input name="alumnoId" value="@Model.AlumnoId" type="hidden" /><div asp-validation-summary="All" class="validation"></div><div class="field"><label asp-for="Desde">Desde</label><input asp-for="Desde" name="desde" type="date" /></div><div class="field"><label asp-for="Hasta">Hasta</label><input asp-for="Hasta" name="hasta" type="date" /></div><div class="field"><label asp-for="EjercicioId">Ejercicio</label><select asp-for="EjercicioId" name="ejercicioId"><option value="">Todos los ejercicios</option>@foreach(var e in Model.Ejercicios){<option value="@e.Id">@e.Nombre</option>}</select></div><div class="field"><label asp-for="RutinaId">Rutina</label><select asp-for="RutinaId" name="rutinaId"><option value="">Todas las rutinas</option>@foreach(var r in Model.Rutinas){<option value="@r.Id">@r.Nombre</option>}</select></div><button class="button primary" type="submit">Filtrar</button><a class="text-link" asp-action="Index" asp-route-alumnoId="@Model.AlumnoId">Limpiar</a></form>
<div class="history-overview"><section class="panel"><div class="section-heading"><div><h2>Evolución semanal</h2><p class="muted">Repeticiones completadas según los filtros seleccionados.</p></div><span class="badge subtle">Por semana</span></div>
@if(Model.Semanas.Count == 0){<p class="empty compact">Completá tu primera sesión para comenzar a ver tu progreso.</p>}
else{<div class="progress-chart" role="img" aria-label="Repeticiones por semana. El detalle numérico se encuentra debajo.">@foreach(var s in Model.Semanas){<div class="chart-column"><span>@s.Repeticiones</span><div class="chart-track"><div class="chart-bar" style="height:@(Math.Max(2, s.Repeticiones * 100 / max))%"></div></div><small>@s.Inicio.ToString("dd/MM")</small></div>}</div><details><summary>Ver datos por semana</summary><div class="table-wrap"><table><thead><tr><th>Semana del</th><th>Sesiones</th><th>Repeticiones</th><th>Segundos</th></tr></thead><tbody>@foreach(var s in Model.Semanas){<tr><td>@s.Inicio.ToString("dd/MM/yyyy")</td><td>@s.Sesiones</td><td>@s.Repeticiones</td><td>@s.Segundos</td></tr>}</tbody></table></div></details>}
</section>
<div class="stats-grid"><div class="stat-card"><div><small>Sesiones en el período</small><strong>@Model.Entrenamientos.Count</strong></div></div><div class="stat-card"><div><small>Repeticiones realizadas</small><strong>@Model.Semanas.Sum(s => s.Repeticiones)</strong></div></div><div class="stat-card"><div><small>Tiempo registrado</small><strong>@Model.Semanas.Sum(s => s.Segundos)<em> seg</em></strong></div></div></div>
</div>
<h2>Entrenamientos anteriores</h2><section class="panel table-panel">
@if(Model.Entrenamientos.Count == 0){<p class="empty compact">No hay sesiones que coincidan con estos filtros.</p>}
else
{
    <div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Rutina</th><th>Series</th><th>Repeticiones</th><th>Devolución</th><th><span class="sr-only">Detalle</span></th></tr></thead><tbody>@foreach(var entrenamiento in Model.Entrenamientos){<tr><td>@entrenamiento.Fecha.ToString("dd/MM/yyyy")</td><td><strong>@entrenamiento.NombreRutina</strong></td><td>@entrenamiento.Registros.Count(r => r.Completada)</td><td>@entrenamiento.Registros.Where(r => r.Completada).Sum(r => r.Repeticiones)</td><td><span class="badge @(entrenamiento.Devoluciones.Count > 0 ? "success" : "pending")">@(entrenamiento.Devoluciones.Count > 0 ? "Con devolución" : "Pendiente")</span></td><td><a class="text-link" asp-controller="Entrenamientos" asp-action="Detalle" asp-route-id="@entrenamiento.Id">@(entrenamiento.Devoluciones.Count > 0 ? "Ver devolución" : "Ver entrenamiento")</a></td></tr>}</tbody></table></div>
}
</section>
