@model List<Notificacion>
@{ ViewData["Title"] = "Notificaciones"; }
<div class="page-heading"><div><h1>Notificaciones</h1><p>Avisos de rutinas, devoluciones, material y mensajes</p></div><form asp-action="LeerTodas" method="post"><button class="button secondary" type="submit">Marcar todas como leídas</button></form></div><div class="tabs"><a class="@(!(bool)ViewBag.SoloPendientes ? "selected" : "")" asp-action="Index">Todas · @ViewBag.Total</a><a class="@((bool)ViewBag.SoloPendientes ? "selected" : "")" asp-action="Index" asp-route-soloPendientes="true">No leídas · @ViewBag.NoLeidas</a></div>
<section class="panel">@if(Model.Count == 0){<div class="empty"><svg><use href="/img/icons.svg#bell" /></svg><h2>Estás al día</h2><p>No hay notificaciones para mostrar.</p></div>}@foreach(var n in Model){<article class="list-row notification-row @(!n.Leida ? "unread" : "")"><span class="row-icon"><svg><use href="/img/icons.svg#bell" /></svg></span><div class="grow"><span class="eyebrow">@n.Tipo</span><p>@n.Texto</p><small class="muted">@Fecha.Local(n.FechaHora).ToString("dd/MM/yyyy HH:mm")</small></div><form asp-action="Leer" method="post"><input name="id" value="@n.Id" type="hidden" /><button class="button secondary small-button notification-open" type="submit">@(n.Leida ? "Ver" : "Leer y abrir")</button></form></article>}</section>
