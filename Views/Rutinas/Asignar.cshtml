@model AsignarViewModel
@{ ViewData["Title"] = "Asignar rutina"; }
<div class="page-heading"><div><h1>Asignar rutina</h1><p>Rutinas › Asignar</p></div></div>
<form method="post" class="form-stack"><input asp-for="RutinaId" type="hidden" /><div asp-validation-summary="All" class="validation"></div><div class="assignment-layout"><section class="panel form-stack"><h2>Rutina</h2><div class="field"><label>Rutina seleccionada</label><div class="readonly-field">@Model.NombreRutina</div></div><h2>Período</h2><div class="form-grid"><div class="field"><label asp-for="FechaDesde">Fecha desde *</label><input asp-for="FechaDesde" type="date" required /></div><div class="field"><label asp-for="FechaHasta">Fecha hasta (opcional)</label><input asp-for="FechaHasta" type="date" /></div></div><span class="badge success">Asignación activa</span></section>
<section class="panel"><div class="section-heading"><h2>Alumnos vinculados</h2><span class="badge" id="selected-students">@Model.AlumnoIds.Count seleccionados</span></div><p class="muted">Podés asignar la rutina a uno o más alumnos.</p>
@if(Model.Alumnos.Count == 0){<p class="empty compact">No tenés alumnos activos vinculados. <a asp-controller="Alumnos" asp-action="Index">Asociar alumno</a></p>}
@foreach(var alumno in Model.Alumnos){<label class="check-row"><input type="checkbox" name="AlumnoIds" value="@alumno.Id" checked="@Model.AlumnoIds.Contains(alumno.Id)" /><span class="avatar small">@Presentacion.Iniciales(alumno.Nombre)</span><span><strong>@alumno.Nombre</strong><small>@alumno.Email</small></span></label>}
</section></div><p class="note">Rutina y al menos un alumno obligatorios · fechas válidas · solo alumnos vinculados · sin superponer otra asignación.</p><div class="form-actions start"><a class="button secondary" asp-action="Index">Cancelar</a><button type="submit" class="button primary">Asignar rutina</button></div><p class="help">Los alumnos reciben una notificación de nueva rutina.</p></form>
