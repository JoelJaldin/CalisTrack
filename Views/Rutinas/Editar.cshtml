@model RutinaViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Nueva rutina" : "Editar rutina"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Rutinas › @(Model.Id == 0 ? "Crear rutina" : "Editar rutina")</p></div></div>
@if(Model.Biblioteca.Count == 0){<div class="alert">Primero agregá ejercicios a tu biblioteca. <a asp-controller="Biblioteca" asp-action="Editar">Crear ejercicio →</a></div>}
<form method="post" id="rutina-form" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div>
<section class="panel form-stack"><div class="field"><label asp-for="Nombre">Nombre de la rutina *</label><input asp-for="Nombre" required maxlength="100" placeholder="Ej. Empuje + Core" /></div><div class="field"><label asp-for="Descripcion">Descripción y recomendaciones (opcional)</label><textarea asp-for="Descripcion" rows="2" maxlength="1000"></textarea></div></section>
<div class="section-heading"><h2>Ejercicios</h2><button type="button" id="add-exercise" class="button secondary small-button"><svg><use href="/img/icons.svg#plus" /></svg>Agregar ejercicio de la biblioteca</button></div>
<section class="panel routine-builder"><div id="routine-rows" class="form-stack">
@for(var i = 0; i < Model.Ejercicios.Count; i++)
{
    <div class="routine-row"><div class="routine-row-header"><strong class="row-number">Ejercicio @(i+1)</strong><div class="actions tight"><button type="button" class="text-button" data-move="up" aria-label="Subir ejercicio">↑</button><button type="button" class="text-button" data-move="down" aria-label="Bajar ejercicio">↓</button><button type="button" class="text-button danger" data-remove-exercise>Quitar</button></div></div><div class="field"><label asp-for="Ejercicios[i].EjercicioId">Ejercicio</label><select asp-for="Ejercicios[i].EjercicioId" required><option value="">Seleccioná un ejercicio</option>@foreach(var ejercicio in Model.Biblioteca){<option value="@ejercicio.Id">@ejercicio.Nombre</option>}</select></div><div class="form-grid three"><div class="field"><label asp-for="Ejercicios[i].Series">Series *</label><input asp-for="Ejercicios[i].Series" min="1" max="20" required /></div><div class="field"><label asp-for="Ejercicios[i].Repeticiones">Repeticiones *</label><input asp-for="Ejercicios[i].Repeticiones" min="1" max="1000" required /></div><div class="field"><label asp-for="Ejercicios[i].DescansoSegundos">Descanso (s)</label><input asp-for="Ejercicios[i].DescansoSegundos" min="0" max="3600" required /></div></div><div class="field"><label asp-for="Ejercicios[i].Observaciones">Observaciones</label><input asp-for="Ejercicios[i].Observaciones" maxlength="500" placeholder="Ej.: bajar controlado" /></div></div>
}
</div></section><p class="note">Nombre obligatorio · al menos un ejercicio · series y repeticiones enteras mayores a 0 · no se puede guardar una rutina vacía.</p><div class="form-actions start"><a class="button secondary" asp-action="Index">Cancelar</a><button type="submit" name="accion" value="guardar" class="button secondary">Guardar</button><button type="submit" name="accion" value="asignar" class="button primary">Guardar y asignar</button></div></form>
