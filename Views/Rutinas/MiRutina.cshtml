@model List<AsignacionRutina>
@{ ViewData["Title"] = "Mi rutina"; }
<div class="page-heading"><div><h1>Mi rutina</h1><p>Rutina vigente asignada por tu entrenador</p></div></div>
@if(Model.Count == 0){<section class="panel empty"><svg><use href="/img/icons.svg#routine" /></svg><h2>Tu próxima rutina está en camino</h2><p>Cuando tu entrenador te asigne una rutina, la vas a encontrar acá.</p><a class="button secondary" asp-controller="Chat" asp-action="Index">Ir al chat</a></section>}
@foreach(var asignacion in Model)
{
    <section class="panel routine-banner"><div class="grow"><h2>@asignacion.Rutina.Nombre</h2><p class="muted">Asignada por @asignacion.Rutina.Entrenador.Nombre · desde @asignacion.FechaDesde.ToString("dd/MM/yyyy") @(asignacion.FechaHasta.HasValue ? "hasta " + asignacion.FechaHasta.Value.ToString("dd/MM/yyyy") : "sin fecha de fin")</p></div><span class="badge @(asignacion.FechaDesde > Fecha.Hoy ? "subtle" : "success")">@(asignacion.FechaDesde > Fecha.Hoy ? "Próximamente" : "Activa")</span>
    @if(asignacion.FechaDesde <= Fecha.Hoy){<form asp-controller="Entrenamientos" asp-action="Comenzar" method="post"><input name="asignacionId" type="hidden" value="@asignacion.Id" /><button class="button primary" type="submit"><svg><use href="/img/icons.svg#play" /></svg>Comenzar entrenamiento</button></form>}</section>
    <h2>Ejercicios</h2><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>#</th><th>Ejercicio</th><th>Series</th><th>Repeticiones</th><th>Descanso</th><th>Observaciones</th><th><span class="sr-only">Técnica</span></th></tr></thead><tbody>
    @foreach(var ejercicio in asignacion.Rutina.Ejercicios.OrderBy(e => e.Orden))
    {
        <tr><td>@ejercicio.Orden</td><td><strong>@ejercicio.Ejercicio.Nombre</strong></td><td>@ejercicio.Series</td><td>@ejercicio.Repeticiones</td><td>@ejercicio.DescansoSegundos s</td><td>@(string.IsNullOrWhiteSpace(ejercicio.Observaciones) ? "—" : ejercicio.Observaciones)</td><td>@if(asignacion.FechaDesde <= Fecha.Hoy){<a class="text-link" asp-action="Tecnica" asp-route-id="@ejercicio.Id">Ver técnica</a>}</td></tr>
    }
    </tbody></table></div></section><p class="help">Tocá “Ver técnica” para ver la explicación y el material de cada ejercicio.</p>
}
