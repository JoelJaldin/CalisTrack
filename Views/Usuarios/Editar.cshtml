@model UsuarioViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Crear usuario" : "Editar usuario"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Usuarios › @(Model.Id == 0 ? "Nueva cuenta" : Model.Nombre)</p></div></div>
<form method="post" class="form-stack"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="user-editor-layout"><section class="panel form-stack"><div class="profile-intro"><span class="avatar large">@Presentacion.Iniciales(Model.Nombre)</span><div><h2>@(Model.Id == 0 ? "Nueva cuenta" : Model.Nombre)</h2><small class="muted">@Model.Email</small></div></div><div class="field"><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" required maxlength="100" /><span asp-validation-for="Nombre"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" required maxlength="200" /><span asp-validation-for="Email"></span><small>Email válido y único.</small></div><div class="field"><label asp-for="Password">@(Model.Id == 0 ? "Contraseña inicial" : "Nueva contraseña (opcional)")</label><input asp-for="Password" autocomplete="new-password" minlength="8" maxlength="100" required="@(Model.Id == 0)" /><span asp-validation-for="Password"></span><small>Mínimo 8 caracteres. @(Model.Id != 0 ? "Dejá el campo vacío para conservar la contraseña actual." : "")</small></div></section>
<section class="panel form-stack"><fieldset class="role-picker"><legend>Rol</legend><div class="role-options vertical">@foreach(var rol in Roles.Todos){<label><input asp-for="Rol" type="radio" value="@rol" /><span><strong>@(rol == Roles.SuperAdmin ? "Super Admin" : rol)</strong><small>@(rol == Roles.Alumno ? "Registra entrenamientos y ve su progreso" : rol == Roles.Entrenador ? "Gestiona alumnos, rutinas y devoluciones" : "Administra usuarios, roles y estados")</small></span></label>}</div><span asp-validation-for="Rol"></span></fieldset><h2>Estado de la cuenta</h2><label class="toggle-field"><span>Cuenta activa</span><input asp-for="Activo" role="switch" /></label><small class="muted">Si está inactiva, el usuario no puede iniciar sesión.</small>
@if(Model.Id != 0){<p class="note">Cambiar el rol o desactivar la cuenta finaliza sus vínculos y asignaciones. Las sesiones se conservan en el historial.</p>}
<div class="form-actions start"><a class="button secondary" asp-action="Index">Cancelar</a><button class="button primary" type="submit">Guardar cambios</button></div></section></div></form>
