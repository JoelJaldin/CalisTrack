@model List<Usuario>
@{ ViewData["Title"] = "Administración de usuarios"; }
<div class="page-heading"><div><h1>Usuarios</h1><p>Administrá cuentas, roles y estados de la plataforma.</p></div><a class="button primary" asp-action="Editar"><svg><use href="/img/icons.svg#plus" /></svg>Crear usuario</a></div>
<div class="list-toolbar"><form class="searchbar" method="get"><svg><use href="/img/icons.svg#search" /></svg><input name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por nombre o email…" aria-label="Buscar usuarios" /><input name="rol" type="hidden" value="@ViewBag.RolFiltro" /><input name="inactivos" type="hidden" value="@(((bool)ViewBag.InactivosFiltro).ToString().ToLowerInvariant())" /><button class="icon-button" aria-label="Buscar"><svg><use href="/img/icons.svg#arrow" /></svg></button></form><div class="filter-chips"><a class="@(string.IsNullOrEmpty((string?)ViewBag.RolFiltro) && !(bool)ViewBag.InactivosFiltro ? "selected" : "")" asp-action="Index">Todos · @ViewBag.Total</a><a class="@(ViewBag.RolFiltro == Roles.Alumno ? "selected" : "")" asp-action="Index" asp-route-rol="Alumno">Alumnos · @ViewBag.Alumnos</a><a class="@(ViewBag.RolFiltro == Roles.Entrenador ? "selected" : "")" asp-action="Index" asp-route-rol="Entrenador">Entrenadores · @ViewBag.Entrenadores</a><a class="@((bool)ViewBag.InactivosFiltro ? "selected" : "")" asp-action="Index" asp-route-inactivos="true">Inactivos · @ViewBag.Inactivos</a></div></div>
<section class="panel table-panel">@if(Model.Count == 0){<p class="empty compact">No hay usuarios que coincidan con la búsqueda.</p>}else{<div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th><span class="sr-only">Acciones</span></th></tr></thead><tbody>@foreach(var u in Model){<tr><td><div class="user-cell"><span class="avatar small">@Presentacion.Iniciales(u.Nombre)</span><span><strong>@u.Nombre</strong><small>@u.Email</small></span></div></td><td><span class="role-badge" data-role="@u.Rol">@(u.Rol == Roles.SuperAdmin ? "Super Admin" : u.Rol)</span></td><td><span class="badge @(u.Activo ? "success" : "muted")">@(u.Activo ? "Activo" : "Inactivo")</span></td><td><a class="text-link" asp-action="Editar" asp-route-id="@u.Id">Editar →</a></td></tr>}</tbody></table></div>}</section>
